# ============================================================
# Vigil Platform — Environment Variables Example
# ============================================================
# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่าตามต้องการ:
#   cp .env.example .env

# ── MQTT Broker ────────────────────────────────────────────
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_CLIENT_ID=vigil-collector

# SEC-001 Phase 2: MQTT subscriber credentials (built-in DB authenticator)
# Generate password: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
# After setting these, run: node scripts/emqx-provision.js
MQTT_SUBSCRIBER_USER=dashboard-subscriber
MQTT_SUBSCRIBER_PASSWORD=change_me_to_random_password

# ── PostgreSQL Database ────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=vigil_platform
DB_USER=vigil_sql
DB_PASSWORD=change_me_to_strong_password

# ── API Server ─────────────────────────────────────────────
API_PORT=3000
# Bind address — default 127.0.0.1 (ทุก consumer เข้าทาง Cloudflare Tunnel/localhost)
# ตั้ง 0.0.0.0 เฉพาะ deployment ที่ต้องเปิด API ให้ LAN ยิงตรง
# BIND_HOST=127.0.0.1
# Port ที่ report-worker bind ไว้รับ on-demand run request จาก api-server (loopback only)
REPORT_WORKER_PORT=3001
# Port ที่ alert-worker bind ไว้รับ /health poll จาก api-server (loopback only)
ALERT_WORKER_PORT=3002

# ── 🔐 Authentication ──────────────────────────────────────
# Secret สำหรับ sign session token (HMAC-SHA256)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ⚠️ สำคัญ: ห้าม commit ค่านี้ขึ้น Git
SESSION_SECRET=change_this_to_random_64_char_hex_string_in_production

# ── Camera Credential Encryption (SEC-014) ─────────────────
# AES-256-GCM key สำหรับ encrypt password + mqtt_password ใน cameras-config.json
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# หลัง generate ให้รัน: node scripts/migrate-creds-encrypt.js
# ⚠️ สำคัญ: เก็บ key นี้ใน password manager — ถ้าหาย credentials กล้องกู้ไม่ได้
CAMERA_SECRET_KEY=generate_with_crypto_randomBytes_32_hex

# ── Blacklist PII Encryption (migration 093) ───────────────
# AES-256-GCM key สำหรับ encrypt เลขบัตร/passport ใน blacklist.* + HMAC match key (id_hash)
# ⚠️ ต้องเป็นคนละ key กับ CAMERA_SECRET_KEY โดยตั้งใจ — camera key รั่วต้องไม่พลอยเปิด PII blacklist
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ⚠️ เปลี่ยน key นี้ = id_number_enc เดิมอ่านไม่ออก + id_hash เดิมใช้ dedup ไม่ได้ทั้งหมด
BLACKLIST_SECRET_KEY=generate_with_crypto_randomBytes_32_hex

# ── Internal Service Token (report-worker ↔ api-server) ────
# ใช้ authenticate report-worker เมื่อ callback หา api-server (X-Internal-Token header)
# ต้องเหมือนกันทั้ง api-server และ report-worker — ไม่ส่งให้ client ใด ๆ
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_API_SECRET=generate_with_crypto_randomBytes_32_hex

# ── Optional: Map Provider ─────────────────────────────────
# Mapbox token สำหรับใช้ map แบบ POI ละเอียด (ฟรี 50K loads/เดือน)
# สมัครฟรีที่ https://account.mapbox.com/auth/signup/
# คัดลอก default public token แล้ววางตรงนี้ (เริ่มต้นด้วย "pk.")
# MAPBOX_TOKEN=pk.eyJ1Ij...

# ── Optional: Debug ────────────────────────────────────────
# DEBUG_MQTT=1                    # เปิด debug MQTT raw payload

# ── MQTT broker (M0/M1 mosquitto migration) ──────────────
# BROKER_KIND=emqx   # 'emqx' หรือ 'mosquitto' — ดู docs/reports/2026-09-27_mosquitto-migration-plan.md
# ใช้เมื่อ BROKER_KIND=mosquitto เท่านั้น (dynamic security provisioner + Central publisher)
# MQTT_PROVISIONER_USER=
# MQTT_PROVISIONER_PASSWORD=
# MQTT_PUBLISHER_USER=
# MQTT_PUBLISHER_PASSWORD=

# ── 🔐 EMQX Broker Dashboard ──────────────────────────────
# SEC-001: overrides default admin/public password on container first start
# Generate: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
# ⚠️ Required — docker-compose will refuse to start without this
EMQX_DASHBOARD_PASSWORD=change_me_to_random_password

# LAN IP ที่กล้อง Bosch จะ connect ไป (ใช้แสดงใน UI ตอน provision MQTT credentials)
# ต้องตรงกับ docker-compose.yml port binding "LAN_IP:1883:1883"
MQTT_CAMERA_BROKER_HOST=192.168.x.x

# ── Performance / tuning knobs (2026-09-06, v1.5.4) ────────
# ทุกตัวมี default ในโค้ดอยู่แล้ว — ปล่อยว่างไว้ได้ ใส่เฉพาะตอนต้องการ override
# ค่าที่เขียนไว้ข้างล่างคือ default จริงที่อ่านจากโค้ด ไม่ใช่ค่าที่แนะนำให้เปลี่ยน

# Log ทุก HTTP request ที่ใช้เวลานานกว่านี้ (มิลลิวินาที) → "[slow-req]" ใน api-server log
# src/api-server.js
# SLOW_REQ_LOG_MS=2000

# รวม script ของ dashboard เป็นไฟล์เดียว /dashboard.bundle.js ตอน boot
# 1 = เปิด (default) · 0 = ปิด เสิร์ฟไฟล์แยกทีละตัวแบบเดิม (ใช้ตอน debug)
# src/helpers/dashboardBundle.js
# DASHBOARD_BUNDLE=1

# ปุ่มดาวน์โหลด PDF/PNG เรนเดอร์ผ่าน report-worker (POST 127.0.0.1:3001/render)
# 1 = เปิด (default) · 0 = เรนเดอร์ในโปรเซส api-server เอง
# หมายเหตุ: ถ้าไม่ได้ตั้ง INTERNAL_API_SECRET จะตกไปเรนเดอร์ในโปรเซสเสมอ ไม่ว่าค่านี้จะเป็นอะไร
# src/helpers/renderViaWorker.js
# REPORT_RENDER_VIA_WORKER=1

# เพดานการนับผลลัพธ์ของ /api/events — ชนเพดานแล้วตอบ header X-Total-Capped: 1
# หน้าจอจะแสดง "10,000+" แทนตัวเลขตรง ๆ
# src/routes/events.js  (หน้า Appearances ใช้ APP_COUNT_CAP ค่าเดียวกัน แยกตัวแปร)
# EVENTS_COUNT_CAP=10000

# ปิด Chromium ของ report-renderer เมื่อไม่มีงานนานเกินนี้ (มิลลิวินาที) — 5 นาที
# src/report-renderer.js
# REPORT_BROWSER_IDLE_MS=300000

# LPR stats warm-up: หน่วงรอบแรกหลัง boot / คาบอุ่น cache ช่วง week / month (มิลลิวินาที)
# src/routes/lpr-query.js
# LPR_WARM_FIRST_RUN_MS=180000
# LPR_WARM_WEEK_EVERY_MS=1800000
# LPR_WARM_MONTH_EVERY_MS=3600000
# รอคิวสถิติ LPR หนักได้นานสุดกี่ ms ก่อนตอบ 503 busy (routes/lpr-query.js)
# LPR_STATS_QUEUE_WAIT_MS=45000

# หน่วงรอบแรกหลัง boot ของ refresher แต่ละตัว (มิลลิวินาที) — เหลื่อมกันไว้
# ไม่ให้ทั้งสามตัวไปแย่ง connection pool พร้อมกันตอน api-server กำลังอุ่น
# src/kpi-stats-refresher.js / category-rollup-refresher.js / traffic-stats-refresher.js
# KPI_STATS_FIRST_RUN_MS=45000
# CAT_ROLLUP_FIRST_RUN_MS=90000
# TRAFFIC_STATS_FIRST_RUN_MS=135000

# ชั่วโมง (0-23, เวลาท้องถิ่น) ที่ traffic-stats จะ reconcile ย้อนหลัง
# ⚠️ คนละตัวกับ TRAFFIC_STATS_RECONCILE_HOURS (ไม่มี S ท้าย) ซึ่งเป็น "ย้อนหลังกี่ชั่วโมง" default 168
# src/traffic-stats-refresher.js
# TRAFFIC_STATS_RECONCILE_HOUR=5
# TRAFFIC_STATS_RECONCILE_HOURS=168

# ยามตรวจนิยาม "ไม่ทราบทะเบียน" (LPR no-read self-check)
# ไม่ตั้ง = รันสัปดาห์ละครั้ง วันอาทิตย์ 04:30 ตามเวลาไทย (ไม่รันตอน boot)
# ตั้งค่านี้ = override เป็นคาบมิลลิวินาที และรันทันที — สำหรับเทสต์เท่านั้น
# src/helpers/noreadCheck.js
# NOREAD_CHECK_INTERVAL_MS=

# src/helpers/helmetMetricCheck.js
# HELMET_METRIC_CHECK_INTERVAL_MS=

# ── Tuning (rarely changed) ────────────────────────────────
# ทะเบียนกลางของ env ทุกตัวอยู่ที่ src/config.js (DEFS) — ค่าที่เขียนไว้ข้างล่างคือ
# default จริงที่อ่านมาจากที่นั่น ไม่ใช่ค่าที่แนะนำให้เปลี่ยน · ปล่อย comment ไว้ได้ทั้งหมด
# ใส่เฉพาะตัวที่ต้องการ override · เพิ่ม env ใหม่ในโค้ด = ต้องลงทะเบียนใน DEFS ก่อน
# ไม่งั้น `npm run check:env` (และ pre-commit) จะไม่ผ่าน
#
# สี่ตัวนี้มาจากโปรเซส/ระบบปฏิบัติการ ไม่ใช่ไฟล์นี้ — ⚠️ อย่าเปิด comment
# APP_NAME=          # ชื่อโปรเซส (api-server/lpr-receiver ตั้งเองตอน boot)
# NODE_ENV=          # 'production' = บังคับกฎเข้มบางข้อ (ตั้งที่ pm2/shell)
# USER=              # ผู้ใช้ระบบ — ใช้แค่ทำ audit log ของ CLI
# SUDO_USER=         # ผู้ใช้ที่รัน sudo — ใช้แค่ทำ audit log ของ CLI

# ACUSEEK_HOST=10.0.10.12  # AcuSeek server host
# ACUSEEK_MAP_FRESH_MS=3600000  # อายุ cache ตาราง camera→AcuSeek (ms)
# ACUSEEK_PORT=80  # AcuSeek server port
# ALLOWED_ORIGINS=  # origin เพิ่มเติมที่ยอมให้เรียก API (คั่นคอมมา)
# APP_COUNT_CAP=10000  # เพดานการนับผลลัพธ์ /api/appearances
# AURAFACE_MATCH_THRESHOLD=0.60  # เกณฑ์ cosine ของ AuraFace (parseFloat ที่ call site)
# AUTH_BACKOFF_MS=2100000  # หน่วงหลังกล้องปฏิเสธ auth (ms) — กัน lockout
# BLACKLIST_AUTO_SYNC=1  # ซิงก์ blacklist source อัตโนมัติ
# BLACKLIST_PUSH_LIVE=0  # push blacklist เข้ากล้องจริง (ไม่ใช่ dry-run)
# BRIDGE_BROKER_URL=wss://dashboard.dojojin.tech/mqtt  # broker ปลายทางของ edge bridge
# BRIDGE_BROKER_URLS=mqtt://100.89.1.29:1883,mqtt://127.0.0.1:18830,wss://dashboard.dojojin.tech/mqtt  # หลายเส้นทาง เรียงตามลำดับ: Tailscale · SSH -R · Cloudflare (src/edge/bridgePaths.js)
# BRIDGE_PASSWORD=  # รหัสผ่าน bridge → EMQX กลาง
# BRIDGE_USERNAME=  # ผู้ใช้ bridge → EMQX กลาง
# CAMERA_TOUCH_EVERY_SEC=30  # ถี่สุดในการอัปเดต last_seen ของกล้อง (วินาที)
# CAMERA_BASELINE_DAYS=14   # ย้อนหลังกี่วันในการหา "นิสัยความเงียบ" ของกล้องแต่ละตัว
# CAMERA_BASELINE_HOUR=1    # ชั่วโมงที่คำนวณฐานใหม่ (วิ่งนาทีที่ :30) · 01:30 กันชน pg_dump 03:00–04:00
# CARTO_API_KEY=  # CARTO key (fallback เมื่อไม่มีใน system_settings)
# CAT_ROLLUP_LOOKBACK_HOURS=3  # ช่วงย้อนหลังที่ rollup คำนวณซ้ำ (ชม.)
# CAT_ROLLUP_REFRESH_MS=300000  # คาบ refresh category rollup (ms)
# CAT_ROLLUP_RETENTION_DAYS=400  # อายุแถว category rollup (วัน)
# DASHBOARD_PUBLIC_URL=  # URL สาธารณะของ dashboard (ใช้ทำลิงก์ภาพเซ็นชื่อ)
# DIAG_CUTOUT_ENABLED=0  # เก็บ diag ของการ crop ป้าย (Dahua)
# DIAG_SNAP_SUPPLY_ENABLED=0  # เก็บ diag ของแหล่งภาพ snapshot (Dahua)
# EDGE_CAMERA_BROKER_URL=  # broker (LAN IP) ที่จะสั่งให้กล้อง Bosch ต่อ ตอนกด "ส่งค่า MQTT เข้ากล้อง" — ไม่ตั้ง = คงที่อยู่เดิมในกล้อง
# EDGE_BROKER=nanomq  # broker บน edge: nanomq | mosquitto — ecosystem.edge.config.js เลือกตัวที่จะรัน (ค่าเริ่มต้น nanomq)
# EDGE_MQTT_REQUIRE_AUTH=0  # LAN listener ของ Mosquitto บน edge บังคับ username/password — เปิดหลังกล้องทุกตัวต่อด้วย user แล้วเท่านั้น
# EDGE_HEARTBEAT_STALE_SEC=180  # ไม่ได้ยิน heartbeat เกินนี้ = edge หลุด (วินาที)
# EDGE_IMAGE_RETENTION_DAYS=  # อายุภาพบน edge (วัน) — ไม่ตั้ง = ใช้ policy/7
# EDGE_MAX_PAYLOAD_BYTES=900000  # เพดานขนาดข้อความที่ edge publish ได้
# EDGE_MODE=0  # โหมด edge — publish ขึ้น MQTT แทนเขียน DB
# EDGE_MQTT_BROKER=mqtt://localhost:1883  # broker ท้องถิ่นของ edge agent
# EDGE_OVERSIZED_DIR=  # โฟลเดอร์เก็บข้อความที่ใหญ่เกิน (default = data/oversized)
# EDGE_OVERSIZED_KEEP=50  # จำนวนไฟล์ oversized ที่เก็บไว้
# EDGE_PRUNE_STALE_MS=10800000  # อายุ state ของ edge ที่ alert-engine ตัดทิ้ง (ms)
# EDGE_SITE_CODE=  # รหัสไซต์ของ edge-config-agent
# EDGE_SITE_ID=edge  # site id ที่ใช้ประกอบ MQTT topic ของ edge
# FACETS_QUERY_TIMEOUT_MS=8000  # timeout ของ query facet
# FACETS_WINDOW_DAYS=1  # ช่วงเวลาที่ facet ย้อนดู (วัน)
# FACE_COUNT_ONLY_TIMEOUT_MS=12000  # timeout ของ query นับใบหน้าอย่างเดียว
# FACE_COUNT_TIMEOUT_MS=500  # timeout ของการนับใบหน้าพร้อมผลลัพธ์
# FACE_MATCH_COUNT_TIMEOUT_MS=500  # timeout ของการนับ face match
# FACE_PUSH_ALLOW=192.168.10.235  # IP กล้องที่ยอมให้ push ใบหน้าเข้ามา
# FACE_PUSH_BIND=192.168.10.31  # ที่อยู่ที่ face-push server bind
# FACE_PUSH_HOST=  # host ที่บอกกล้องให้ push มา (ว่าง = ไม่ตั้งค่าให้กล้อง)
# FACE_PUSH_PORT=3010  # พอร์ต face-push server
# FACE_ROSTER_TTL_MS=60000  # อายุ cache ของ face roster
# FAS_MAX_BODY_BYTES=10485760  # เพดาน body ของ Alarm Server (bytes)
# FILES_HOST=  # hostname เฉพาะสำหรับเสิร์ฟไฟล์ (ว่าง = ปิด)
# FILES_PUBLIC_URL=  # URL สาธารณะของโฮสต์ไฟล์ (fallback ไป DASHBOARD_PUBLIC_URL)
# FR_PORT=8791  # พอร์ตของ face engine (loopback)
# HCP_ACCOUNT_ID=38051848  # account id ของ HikCentral
# HCP_CAMERA_MAP=  # ไฟล์ map กล้อง HCP (default = src/hcp-camera-map.json)
# HCP_DEVICES_FRESH_MS=60000  # อายุ cache รายการอุปกรณ์ HCP
# HCP_HOST=10.0.10.9  # HikCentral host
# HCP_LIVE_LOOKBACK_MIN=15  # ช่วงย้อนหลังที่ดึง face match สด (นาที)
# HCP_LIVE_POLL_SEC=60  # คาบ poll face match สด (วินาที)
# HCP_OPTIONAL=  # ความสามารถเสริมของ HCP ที่เปิด (คั่นคอมมา)
# HCP_PORT=8443  # HikCentral port
# HCP_SECRET_KEY_ENC=  # HCP app secret (เข้ารหัสไว้)
# KPI_STATS_LOOKBACK_HOURS=3  # ช่วงย้อนหลังที่ kpi คำนวณซ้ำ (ชม.)
# KPI_STATS_RECONCILE_HOUR=5  # ชั่วโมง (0-23 เวลาไทย) ที่ kpi เก็บตกย้อนหลังเท่าอายุตาราง — หลัง backup จบ (GOTCHAS #191/#237)
# CAT_ROLLUP_RECONCILE_HOUR=5  # ชั่วโมง (0-23 เวลาไทย) ที่ event_dim_bucket เก็บตก 7 วันย้อนหลัง (GOTCHAS #239)
# APP_ROLLUP_FIRST_RUN_MS=240000  # หน่วงรอบแรกของ appearance rollup (ms)
# APP_ROLLUP_LOOKBACK_HOURS=3  # ช่วงย้อนหลังที่ appearance rollup คำนวณซ้ำ (ชม.)
# APP_ROLLUP_RECONCILE_HOUR=5  # ชั่วโมง (0-23 เวลาไทย) ที่ appearance_dim_hourly เก็บตก 7 วันย้อนหลัง
# APP_ROLLUP_REFRESH_MS=300000  # คาบ refresh appearance rollup (ms)
# APP_ROLLUP_RETENTION_DAYS=45  # อายุแถว appearance rollup (วัน)
# KPI_STATS_REFRESH_MS=300000  # คาบ refresh kpi (ms)
# KPI_STATS_RETENTION_DAYS=7  # อายุแถว kpi (วัน)
# LINE_FACE_FULL_FRAME=0  # ส่งภาพเต็มเฟรมแทน crop ในแจ้งเตือนใบหน้า
# LONG_TX_ALERT_MIN=20 minutes  # อายุ transaction ที่ถือว่านานผิดปกติ (interval)
# LPR_BIND_HOST=0.0.0.0  # ที่อยู่ที่ lpr-receiver bind
# LPR_DIAG_CAMS=  # กล้องที่เก็บ XML ดิบไว้ debug
# LPR_DIAG_DIR=  # โฟลเดอร์เก็บ diag LPR (default = data/lpr-diag)
# LPR_DIAG_EVERY_SEC=30  # เก็บ diag 1 ใบต่อกล้องต่อกี่วินาที
# LPR_DIAG_MAX_MB=500  # เพดานพื้นที่ diag LPR (MB)
# LPR_DIAG_WATCH=vehileSubLogoRecog,vehileModel  # ฟิลด์ที่เจอแล้วเก็บทันที (สะกดตามกล้อง)
# LPR_FACE_DIR=  # โฟลเดอร์เก็บภาพที่ classify ไม่ออก (null = ปิด)
# LPR_FACE_MAX_MB=4000  # เพดานพื้นที่ภาพ face ของ LPR (MB)
# LPR_FACE_VEHICLE=  # เก็บเฉพาะรถชนิดนี้ (null = ทุกชนิด)
# LPR_PUSH_HOST=  # IP ที่บอกกล้อง ANPR ให้ push มา (ไม่ตั้ง = ใช้ localAddress)
# LPR_RECEIVER_PORT=3003  # พอร์ต lpr-receiver
# LPR_SCENE_CAMS=  # กล้องที่เก็บภาพ scene เต็มเฟรมไว้ debug
# LPR_SCENE_EVERY_SEC=60  # เก็บ scene 1 ใบต่อกล้องต่อกี่วินาที
# META_CROP_MINPX=40  # ขนาดต่ำสุดของกรอบวัตถุที่ยอม crop (px)
# META_CROP_PAD=0.12  # ระยะเผื่อรอบกรอบวัตถุ (สัดส่วน, parseFloat ที่ call site)
# META_SNAP_LAG_MS=0  # ชดเชยเวลาต่างระหว่าง metadata กับ snapshot (ms)
# PARTNER_HOST=  # hostname เฉพาะของ partner API (ว่าง = ปิด)
# PORT=3000  # พอร์ตที่ยิงกลับหาตัวเองผ่าน loopback
# PREVIEW_INTERVAL_MS=120000  # คาบส่งภาพ preview ของ edge agent (ms)
# PUBLIC_ORIGIN=  # origin สาธารณะ (ไม่ตั้ง = เดาจาก Host header)
# SD_POLL_INTERVAL_MS=3600000  # คาบอ่านสถานะ microSD ของกล้อง (ms)
# SNAPSHOT_DIR=  # โฟลเดอร์ snapshot (ไม่ตั้ง = ค่าในโค้ด)
# SNAPSHOT_PROXY_DOMAIN=dojojin.tech  # โดเมนฐานของ edge proxy
# SNAPSHOT_PROXY_SECRET=  # Bearer/HMAC key ของ edge proxy + ลิงก์ภาพเซ็นชื่อ
# SNAPSHOT_PROXY_URL=  # URL proxy ตรง (ใช้เมื่อไม่มี site code)
# SNAPSHOT_PUBLISHER_PASSWORD=  # รหัสผ่าน MQTT ของ ingester ที่ publish snapshot
# SNAPSHOT_PUBLISHER_USER=  # ผู้ใช้ MQTT ของ ingester ที่ publish snapshot
# RETAIN_REPLAY_GRACE_MS=5000  # ms after (re)connect where retained MQTT is treated as replay (GOTCHAS #103)
# SNAP_COOLDOWN_MS=3000  # เว้นระยะระหว่างการดึง snapshot ซ้ำ (ms)
# SNAP_REFETCH_MIN_MS=1000  # ระยะต่ำสุดก่อนดึง snapshot ใหม่ (ms)
# STREAM_STALE_MS=300000  # สตรีมเงียบเกินนี้ = ตาย (ms)
# TRAFFIC_STATS_LOOKBACK_HOURS=3  # ช่วงย้อนหลังที่ traffic คำนวณซ้ำ (ชม.)
# TRAFFIC_STATS_REFRESH_MS=900000  # คาบ refresh traffic (ms)
# TRAFFIC_STATS_RETENTION_DAYS=120  # อายุแถว traffic (วัน)
# VCA_RULES_POLL_INTERVAL_MS=3600000  # คาบตรวจชื่อกฎ (IVA task) เกิน 64 byte ของกล้อง (ms)
