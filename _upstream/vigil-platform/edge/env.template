# ============================================================
# Vigil Platform — EDGE .env template
# ------------------------------------------------------------
# คัดลอกไฟล์นี้ไปที่ src/.env แล้วแก้ค่าตาม site
# NEVER commit src/.env — gitignored
# สร้าง secrets ใหม่ต่อ site: openssl rand -hex 32
# ============================================================

# ── Edge mode ──────────────────────────────────────────────
EDGE_MODE=1
EDGE_SITE_ID=<site_code>            # เช่น vss, bkk1, cmx2, nrw
# EDGE_SITE_CODE ต้องมีและต้องเท่ากับ EDGE_SITE_ID — edge-config-agent.js อ่านตัวนี้
# โดยไม่มี fallback ถ้าไม่ตั้ง agent จะไม่ subscribe หัวข้อ config ของไซต์ แล้วเงียบไป
# เฉย ๆ ไม่มี error (เจอจริงตอน setup ไซต์ nrw 2026-08-30 — template เดิมไม่มีบรรทัดนี้)
EDGE_SITE_CODE=<site_code>

# ── Bridge → Central EMQX ─────────────────────────────────
BRIDGE_BROKER_URL=wss://dashboard.dojojin.tech/mqtt
BRIDGE_USERNAME=edge-<site_code>    # EMQX account สร้างบน central
BRIDGE_PASSWORD=<strong_random_password>

# ── Cloudflare Tunnel ──────────────────────────────────────
TUNNEL_TOKEN=<token_from_cloudflare_zero_trust>

# ── MQTT Broker (LOCAL NanoMQ) ─────────────────────────────
MQTT_BROKER_URL=mqtt://127.0.0.1:1883
MQTT_CLIENT_ID=vigil-edge
MQTT_SUBSCRIBER_USER=dashboard-subscriber
MQTT_SUBSCRIBER_PASSWORD=<random>

# ── PostgreSQL — DB-LESS EDGE (ไม่ได้ใช้จริง) ──────────────
# Edge box ไม่มี Postgres — ค่าด้านล่างเป็น placeholder
# ถ้า ingester มี query หลุด guard จะ fail ที่ ECONNREFUSED
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=vigil_platform
DB_USER=vigil_sql
DB_PASSWORD=unused_on_edge

# ── Data retention ────────────────────────────────────────
# จำนวนวันที่เก็บ snapshot ของ Bosch ไว้บน edge — edge/bridge.js อ่านตัวนี้ตอน prune
# รายชั่วโมง ไม่ตั้ง = ใช้ค่า default ในโค้ด (7 วัน)
EDGE_IMAGE_RETENTION_DAYS=7

# ── Ports ──────────────────────────────────────────────────
LPR_RECEIVER_PORT=3003
FACE_PUSH_BIND=0.0.0.0             # bind ทุก interface ให้กล้อง push มาได้
FACE_PUSH_PORT=3010
API_PORT=3000                       # unused on edge
REPORT_WORKER_PORT=3001             # unused on edge
ALERT_WORKER_PORT=3002              # unused on edge

# ── Secrets (สร้างใหม่ต่อ site — ยกเว้น CAMERA_SECRET_KEY) ──
SESSION_SECRET=<openssl rand -hex 32>
CAMERA_SECRET_KEY=<COPY EXACT VALUE FROM CENTRAL src/.env — DO NOT generate new>    # ต้องตรงกับ Central เป๊ะ ไม่งั้น decrypt camera credentials พังทันที (GOTCHAS #98)
INTERNAL_API_SECRET=<openssl rand -hex 32>
SNAPSHOT_PROXY_SECRET=<COPY EXACT VALUE FROM CENTRAL src/.env — DO NOT generate new># ต้องตรงกับ Central เป๊ะ — central ใช้ตัวนี้เรียก lpr-receiver ของ edge (httphost-*, event-broker-*, snapshot proxy) ไม่ตรง = ทุก request จาก central ได้ 401
BLACKLIST_SECRET_KEY=<COPY EXACT VALUE FROM CENTRAL src/.env — DO NOT generate new>  # ต้องตรงกับ Central เป๊ะ — ไม่ตั้ง = hcp-face-matches worker crash (blacklist-crypto.js: "refusing to store PII unencrypted")

# ── Edge networking (จำเป็นถ้ากล้อง face push เข้าเครื่องนี้) ─
EDGE_MQTT_BROKER=mqtt://127.0.0.1:1883   # local NanoMQ — ปกติไม่ต้องแก้ นอกจาก broker ไม่ได้รันที่ localhost
LPR_PUSH_HOST=<this edge's own LAN IP, e.g. 172.29.51.52>   # ให้ /api/cameras/:id/httphost-set รู้ว่าจะ repoint กล้องมาที่ IP ไหน — ไฟล์นี้ gitignored จึงหายได้ตอน rebuild เครื่อง (เจอจริง 2026-08-17 บน hkt หลัง restart lpr-receiver หลายรอบ) ต้องตั้งใหม่เองทุกครั้งที่ setup เครื่อง
# FACE_PUSH_HOST — ⚠️ รูปแบบขัดกันเองระหว่าง 2 จุดที่ใช้ (ยังไม่ได้แก้โค้ด 2026-08-18):
#   - Hik ISAPI httpHost IP check (lpr-receiver.js: face.ip === FACE_PUSH_HOST) ต้องการ "IP เปล่า" เช่น 172.29.51.52
#   - Bosch ONVIF AddEventBroker (lpr-receiver.js: mqtt://${FACE_PUSH_HOST}) ต้องการ "host:port" เช่น 172.29.51.52:1883
#   ไซต์ที่ใช้ทั้ง Bosch และ Hik face push พร้อมกันจะตั้งให้ถูกทั้งคู่ไม่ได้ — ตั้งตามฟีเจอร์ที่ไซต์นี้ใช้จริงไปก่อน แล้วดูเรื่อง GOTCHAS/แผนแก้ก่อน setup เครื่องถัดไป
FACE_PUSH_HOST=<see comment above — depends what this site uses>
# FACE_PUSH_ALLOW — allowlist ของ IP กล้องที่ push ใบหน้าเข้ามาที่พอร์ต 3010 โดยตรง
# hikvision-isapi.js:1313 ใช้ค่า default เป็น '192.168.10.235' ถ้าไม่ตั้ง ⇒ ไซต์ที่อยู่
# subnet อื่นจะได้ 403 ทุก push แบบเงียบ ๆ (GOTCHAS #133) · คั่นหลาย IP ด้วยจุลภาค
FACE_PUSH_ALLOW=<IP กล้องที่ push face, คั่นด้วย , เช่น 172.17.2.51,172.17.2.52>

# ── Central EMQX dashboard pw (ไม่ใช้บน edge, ใส่ไว้ parity) ──
EMQX_DASHBOARD_PASSWORD=unused_on_edge
