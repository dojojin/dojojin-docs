# ============================================================
# Vigil Platform — EDGE .env template
# ------------------------------------------------------------
# คัดลอกไฟล์นี้ไปที่ src/.env แล้วแก้ค่าตาม site
# NEVER commit src/.env — gitignored
# สร้าง secrets ใหม่ต่อ site: openssl rand -hex 32
# ============================================================

# ── Edge mode ──────────────────────────────────────────────
EDGE_MODE=1
EDGE_SITE_ID=<site_code>            # เช่น vss, bkk1, cmx2

# ── Bridge → Central EMQX ─────────────────────────────────
BRIDGE_BROKER_URL=wss://dashboard.dojojin.tech/mqtt
BRIDGE_USERNAME=edge-<site_code>    # EMQX account สร้างบน central
BRIDGE_PASSWORD=<strong_random_password>

# ── Cloudflare Tunnel ──────────────────────────────────────
TUNNEL_TOKEN=<token_from_cloudflare_zero_trust>

# ── MQTT Broker (LOCAL NanoMQ) ─────────────────────────────
MQTT_BROKER_URL=mqtt://127.0.0.1:1883
MQTT_CLIENT_ID=vigil-edge
MQTT_SUBSCRIBER_USER=dashboard-subscriber
MQTT_SUBSCRIBER_PASSWORD=<random>

# ── PostgreSQL — DB-LESS EDGE (ไม่ได้ใช้จริง) ──────────────
# Edge box ไม่มี Postgres — ค่าด้านล่างเป็น placeholder
# ถ้า ingester มี query หลุด guard จะ fail ที่ ECONNREFUSED
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=vigil_platform
DB_USER=vigil_sql
DB_PASSWORD=unused_on_edge

# ── Ports ──────────────────────────────────────────────────
LPR_RECEIVER_PORT=3003
FACE_PUSH_BIND=0.0.0.0             # bind ทุก interface ให้กล้อง push มาได้
FACE_PUSH_PORT=3010
API_PORT=3000                       # unused on edge
REPORT_WORKER_PORT=3001             # unused on edge
ALERT_WORKER_PORT=3002              # unused on edge

# ── Secrets (สร้างใหม่ต่อ site — ยกเว้น CAMERA_SECRET_KEY) ──
SESSION_SECRET=<openssl rand -hex 32>
CAMERA_SECRET_KEY=<COPY EXACT VALUE FROM CENTRAL src/.env — DO NOT generate new>    # ต้องตรงกับ Central เป๊ะ ไม่งั้น decrypt camera credentials พังทันที (GOTCHAS #98)
INTERNAL_API_SECRET=<openssl rand -hex 32>

# ── Central EMQX dashboard pw (ไม่ใช้บน edge, ใส่ไว้ parity) ──
EMQX_DASHBOARD_PASSWORD=unused_on_edge
